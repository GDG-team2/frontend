# 기본값은 실제 API 연결입니다. 실행 중인 백엔드가 없으면 연결 오류를 표시합니다.
EXPO_PUBLIC_USE_MSW=false
# /api/v1 포함. 실제 기기는 localhost 대신 접근 가능한 서버 IP/도메인을 사용하세요.
# Expo Metro 포트(기본 8081)와 백엔드 포트가 겹치면 bun start --port 8082
EXPO_PUBLIC_API_BASE_URL=http://localhost:8081/api/v1

# 서버 없이 QA할 때만 EXPO_PUBLIC_USE_MSW=true로 바꾸고 앱을 다시 시작하세요.
