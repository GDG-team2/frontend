{
  "cli": {
    "version": ">= 24.8.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "bun": "1.3.14",
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "bun": "1.3.14",
      "distribution": "internal"
    },
    "production": {
      "bun": "1.3.14",
      "autoIncrement": true
    },
    "release": {
      "extends": "production",
      "distribution": "internal",
      "environment": "preview",
      "credentialsSource": "remote",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_USE_MSW": "false",
        "EXPO_PUBLIC_API_BASE_URL": "https://ohakkom-backend.onrender.com/api/v1"
      }
    }
  }
}
