{
  "expo": {
    "name": "오하꼼",
    "slug": "ohakkom",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ohakkom",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.ohakkom.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "오하꼼이 미션 이동 중 남은 거리와 도착 여부를 안내하기 위해 위치를 사용합니다."
      }
    },
    "android": {
      "package": "com.ohakkom.app",
      "adaptiveIcon": {
        "backgroundColor": "#D9F56A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "오하꼼이 미션 이동 중 남은 거리와 도착 여부를 안내하기 위해 위치를 사용합니다."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F2F1EB",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "mocking": {
        "enabledByDefault": true
      },
      "kakao": {
        "status": "awaiting-app-keys"
      }
    }
  }
}
